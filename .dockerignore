# Ignore local Python artifacts and virtual environment
backend/venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.pytest_cache/
backend/insightiq.db*
backend/*.lock

# Ignore local Node and frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Ignore version control and OS metadata
.git/
.gitignore
.DS_Store
*.log
